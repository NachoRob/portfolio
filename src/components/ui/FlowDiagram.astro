---
/**
 * Flujo de arquitectura como lista ordenada (legible por lectores de pantalla).
 * Nodos simples unidos por una línea vertical.
 */
interface Step {
  label: string;
  detail?: string | undefined;
}
interface Props {
  steps: Step[];
  title?: string;
}

const { steps, title } = Astro.props;
---

<figure>
  {title && <figcaption>{title}</figcaption>}
  <ol>
    {
      steps.map((step, i) => (
        <li>
          <span class="n">{String(i + 1).padStart(2, '0')}</span>
          <span>
            <span class="label">{step.label}</span>
            {step.detail && <span class="detail">{step.detail}</span>}
          </span>
        </li>
      ))
    }
  </ol>
</figure>

<style>
  figure {
    font-family: var(--font-mono);
  }
  figcaption {
    margin-bottom: 0.75rem;
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-muted);
  }
  ol {
    position: relative;
    display: grid;
    gap: 0.5rem;
  }
  ol::before {
    content: '';
    position: absolute;
    top: 0.75rem;
    bottom: 0.75rem;
    left: 1.2rem;
    width: 1px;
    background: var(--line-strong);
  }
  li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    background: var(--canvas);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  li:first-child {
    border-color: var(--brand);
  }
  .n {
    font-size: var(--text-micro);
    color: var(--link);
  }
  .label {
    display: block;
    font-size: var(--text-small);
    color: var(--fg);
    line-height: 1.3;
  }
  .detail {
    display: block;
    font-size: var(--text-micro);
    color: var(--fg-muted);
  }
</style>
