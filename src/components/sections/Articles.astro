---
import { getCollection } from 'astro:content';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Icon from '@/components/ui/Icon.astro';
import { articleTopics } from '@/lib/taxonomy';

const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const fmt = new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const sources = { propio: 'NachoDev', medium: 'Medium', d2b: 'Blog D2B', devto: 'DEV' } as const;
---

{
  articles.length > 0 && (
    <section id="articulos" aria-labelledby="articulos-title" class="page block">
      <SectionHeading
        id="articulos-title"
        title="Artículos"
        lead="Lo que aprendo midiendo y construyendo con IA: visibilidad de marca en LLMs, analítica y agentes."
      />
      <ul class="list">
        {articles.map((a) => {
          const external = Boolean(a.data.url);
          return (
            <li>
              <a
                href={a.data.url}
                class="tile"
                lang={a.data.lang}
                {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                <span class="tile-icon">
                  <Icon name="file-text" size={22} />
                </span>
                <span class="body">
                  <span class="tile-title">{a.data.title}</span>
                  <span class="tile-text" lang="es">
                    {a.data.description}
                  </span>
                  <span class="tile-meta" lang="es">
                    <span>{sources[a.data.source]}</span>
                    <time datetime={a.data.pubDate.toISOString()}>{fmt.format(a.data.pubDate)}</time>
                    <span>{articleTopics[a.data.topic]}</span>
                    {a.data.lang === 'en' && <span>En inglés</span>}
                  </span>
                </span>
                <Icon name={external ? 'arrow-up-right' : 'arrow-right'} size={20} class="arrow" />
                {external && (
                  <span class="sr-only" lang="es">
                    (se abre en {sources[a.data.source]}, en una pestaña nueva)
                  </span>
                )}
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )
}

<style>
  .block {
    margin-top: var(--section-gap);
  }
  .list {
    display: grid;
    gap: 0.875rem;
  }
  /* Artículos: tile blanco con texto navy (16:1) en ambos modos. */
  .tile {
    align-items: flex-start;
    --tile-bg: var(--white);
    --tile-fg: var(--navy);
  }
  .body {
    flex: 1;
    min-width: 0;
  }
  .tile-text {
    margin-top: 0.2rem;
  }
  .tile-icon {
    margin-top: 0.1rem;
  }
  .tile :global(.arrow) {
    flex: none;
    align-self: center;
    transition: transform 0.12s ease;
  }
  .tile:hover :global(.arrow) {
    transform: translate(2px, -2px);
  }
</style>
