---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ArticleList from '@/components/ArticleList.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { getArticles } from '@/lib/articles';
import { href } from '@/lib/url';

/** En la home solo los más recientes; el resto vive en /blog/. */
const LATEST = 4;
const articles = await getArticles();
---

{
  articles.length > 0 && (
    <section id="articulos" aria-labelledby="articulos-title" class="page block">
      <SectionHeading
        id="articulos-title"
        title="Artículos"
        lead="Lo que aprendo midiendo y construyendo con IA: visibilidad de marca en LLMs, analítica y agentes."
      />
      <ArticleList articles={articles.slice(0, LATEST)} />
      <p class="more">
        <Button href={href('blog/')} variant="secondary">
          Todos los artículos
          <Icon name="arrow-right" size={18} />
        </Button>
      </p>
    </section>
  )
}

<style>
  .block {
    margin-top: var(--section-gap);
  }
  .more {
    margin-top: 1.75rem;
  }
</style>
