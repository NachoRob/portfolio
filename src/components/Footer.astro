---
import Logo from '@/components/ui/Logo.astro';
import { site } from '@/data/site';
import { href } from '@/lib/url';

const year = new Date().getFullYear();
---

<footer>
  <div class="page">
    <a href={href()} class="brand"><Logo onDark /></a>
    <p class="motto mono">{site.philosophy.join(' · ')}</p>
    <p class="copy">© {year} {site.name} · Hecho con Astro desde Chile.</p>
  </div>
</footer>

<style>
  footer {
    margin-top: var(--section-gap);
    padding-block: 2.5rem 3rem;
    background: var(--navy);
    color: var(--on-navy-secondary);
    text-align: center;
  }
  .brand {
    display: inline-block;
    font-size: 1.375rem;
  }
  .motto {
    margin-top: 0.75rem;
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    color: var(--on-navy-accent);
  }
  .copy {
    margin-top: 0.5rem;
    font-size: var(--text-micro);
  }
  footer :focus-visible {
    outline-color: var(--on-navy-accent);
  }
</style>
